{
  "name": "causal-proof",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-constrained causal investigation and counterfactual simulation platform.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:showcase": "npm run build:showcase && playwright test -c playwright.showcase.config.ts",
    "test:watch": "vitest",
    "build:showcase": "vite build --config showcase/vite.config.ts",
    "preview:showcase": "vite preview --config showcase/vite.config.ts",
    "verify:showcase": "node scripts/verify-showcase.mjs",
    "hash:showcase": "node scripts/hash-showcase.mjs",
    "test:pages:rollback": "node scripts/test-pages-rollback.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "measure:phase8": "node scripts/measure-phase8.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "js-sha256": "0.11.1",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.15.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "25.0.1",
    "typescript": "5.6.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
